{
    "compilerOptions": {
      "target": "ES2020",
      "module": "ES2020",
      "lib": ["ES2020", "DOM", "DOM.Iterable"],
      "rootDir": ".",
      "outDir": "./dist",
      "strict": true,
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "skipLibCheck": true
    },
    "include": ["app.ts"],
    "exclude": ["node_modules", "dist"]
}